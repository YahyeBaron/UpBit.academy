# ════════════════════════════════════════════════════════════════
# 🎓 UpBit Academy — Environment Variables Configuration
# ════════════════════════════════════════════════════════════════

# ── 1. Database (PostgreSQL / Neon) ──
DATABASE_URL="postgresql://neondb_owner:password@ep-square-block-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=5"
DIRECT_URL="postgresql://neondb_owner:password@ep-square-block.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── 2. Redis (Upstash) ──
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AXXXxxx="

# ── 3. Clerk Authentication ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Get from: Clerk Dashboard → Webhooks → Your endpoint → Signing Secret
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ── 4. Inngest Background Job Queue ──
# Get from: app.inngest.com → Your App → Keys
INNGEST_SIGNING_KEY=signkey-prod-xxxxxxxxxxxx
INNGEST_EVENT_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# ── 5. Sifalo Pay Payment Gateway ──
SIFALO_PAY_USERNAME=su_your_sifalo_username
SIFALO_PAY_API_KEY=sp_your_sifalo_api_key
SIFALO_PAY_API_URL=https://api.sifalopay.com/v1/payment
# Get from: Sifalo Pay Dashboard → Webhook Settings → Signing Secret
SIFALO_WEBHOOK_SECRET=whsec_sifalo_hmac_secret_key
SIFALO_MERCHANT_ZAAD=+252634718722
SIFALO_MERCHANT_EDAHAB=+252654718722
SIFALO_MERCHANT_PREMIER_WALLET=+252634718722
SIFALO_MERCHANT_PREMIER_ACCOUNT=130146287001

# ── 6. Super Admin Credentials ──
ADMIN_PASSWORD=YourStrongPassword2026!

# ── 7. Email Service (Resend) ──
SENDER_EMAIL=noreply@yourdomain.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Use a verified custom domain — NOT onboarding@resend.dev in production
RESEND_FROM_EMAIL="UpBit Academy <noreply@yourdomain.com>"
# Get from: resend.com → Webhooks → Your endpoint → Secret
RESEND_WEBHOOK_SECRET=whsec_resend_xxxxxxxxxxxxxxx

# ── 8. Real-Time WebSockets (Pusher) ──
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=ap2
NEXT_PUBLIC_PUSHER_KEY=your_pusher_key
NEXT_PUBLIC_PUSHER_CLUSTER=ap2

# ── 9. Behavior Analytics (PostHog) ──
POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_ID=your_posthog_project_id

# ── 10. Mux Video Streaming ──
NEXT_PUBLIC_MUX_ENV_KEY=your_mux_env_key
MUX_ENV_ID=your_mux_env_id
# Get from: Mux Dashboard → Settings → Webhooks → Signing Secret
MUX_WEBHOOK_SECRET=whsec_mux_signing_secret_from_dashboard
# Get from: Mux Dashboard → Settings → Signing Keys
MUX_SIGNING_KEY_ID=your_mux_signing_key_id
MUX_SIGNING_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
MUX_TOKEN_EXPIRATION_SECONDS=21600

# ── 11. File Storage (UploadThing) ──
UPLOADTHING_TOKEN=eyJhcGlLZXkiOiJza19saXZl...

# ── 12. Error Monitoring (Sentry) ──
# Get DSN from: sentry.io → Settings → Projects → upbit-academy → Client Keys
NEXT_PUBLIC_SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXXXXXX
SENTRY_ORG=bit-9re
SENTRY_PROJECT=upbit-academy
# Get from: sentry.io → Settings → Auth Tokens (needs project:releases + org:read scopes)
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxx

# ── 13. Search (Meilisearch) ──
# Get from: cloud.meilisearch.com → Your instance, OR use Docker (see docker-compose.enterprise.yml)
MEILISEARCH_URL=https://your-instance.meilisearch.io
MEILISEARCH_MASTER_KEY=your_meilisearch_master_key

# ── 14. Internal Monitoring ──
# Any 32+ character random string — used to authenticate /api/db-metrics externally
# Generate: openssl rand -base64 32
INTERNAL_METRICS_TOKEN=your_32_plus_char_random_monitoring_token

# ── 15. Docker (only needed for self-hosted PostgreSQL) ──
POSTGRES_PASSWORD=YourStrongDbPassword2026!
