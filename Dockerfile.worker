# ════════════════════════════════════════════════════════════════
# UpBit Academy — Dedicated Background Worker Dockerfile
# Base: node:22-alpine | Standalone daemon runner
# ════════════════════════════════════════════════════════════════

FROM node:22-alpine AS worker-base

RUN apk add --no-cache libc6-compat openssl curl
WORKDIR /app

# Copy package manifests & prisma schema
COPY package.json package-lock.json* pnpm-lock.yaml* ./
COPY prisma ./prisma
COPY tsconfig.json ./

# Install dependencies
RUN \
  if [ -f pnpm-lock.yaml ]; then \
    npm install -g pnpm && pnpm install --frozen-lockfile; \
  elif [ -f package-lock.json ]; then \
    npm ci; \
  else \
    npm install; \
  fi

# Generate Prisma Client
RUN npx prisma generate

# Copy source files required for worker execution
COPY lib ./lib
COPY scripts ./scripts

# Create non-root system user for security
RUN addgroup --system --gid 1001 nodejs \
 && adduser  --system --uid 1001 nextjs \
 && chown -R nextjs:nodejs /app

USER nextjs

ENV NODE_ENV=production

CMD ["npx", "ts-node", "--transpile-only", "scripts/standalone-worker.ts"]
